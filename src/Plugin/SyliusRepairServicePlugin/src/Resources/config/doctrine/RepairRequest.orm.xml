<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="SyliusRepairServicePlugin\Entity\RepairRequest" table="sylius_repair_request" repository-class="SyliusRepairServicePlugin\Repository\RepairRequestRepository">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO" />
        </id>

        <many-to-one field="customer" target-entity="Sylius\Component\Customer\Model\CustomerInterface">
            <join-column name="customer_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <field name="code" type="string" column="code" length="255" unique="true" />
        <field name="deviceName" type="string" column="device_name" length="255" />
        <field name="deviceBrand" type="string" column="device_brand" length="255" nullable="true" />
        <field name="deviceModel" type="string" column="device_model" length="255" nullable="true" />
        <field name="issueDescription" type="text" column="issue_description" />
        <field name="status" type="string" column="status" length="64" />
        <field name="customerName" type="string" column="customer_name" length="255" />
        <field name="customerEmail" type="string" column="customer_email" length="255" />
        <field name="customerPhoneNumber" type="string" column="customer_phone_number" length="64" nullable="true" />
        <field name="diagnosisNotes" type="text" column="diagnosis_notes" nullable="true" />
        <field name="repairNotes" type="text" column="repair_notes" nullable="true" />
        <field name="createdAt" type="datetime_immutable" column="created_at" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true" />
    </entity>
</doctrine-mapping>
