{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}
	{{ 'sylius_best_seller.ui.best_seller_settings'|trans }}
	{{ parent() }}
{% endblock %}

{% block body %}
	{% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' ignore missing %}
	{% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' ignore missing %}

	<div class="page-wrapper">
		<header class="page-header d-print-none">
			<div class="container-xl">
				<div class="row g-2 align-items-center">
					<div class="col">
						<div class="page-pretitle">
							{{ 'sylius_best_seller.ui.configure_best_seller_display'|trans }}
						</div>
						<h2 class="page-title">
							<i class="ti ti-trophy me-2"></i>
							{{ 'sylius_best_seller.ui.best_seller_settings'|trans }}
						</h2>
					</div>
				</div>
			</div>
		</header>

		<div class="page-body">
			<div class="container-xl">
				<div class="row row-cards">
					<div class="col-12">
						<div class="card">
							<div class="card-header">
								<h3 class="card-title">{{ 'sylius_best_seller.ui.most_popular_products'|trans }}</h3>
							</div>
							<div class="card-body">
								{{ form_start(form, {'attr': {'class': 'ui form', 'novalidate': 'novalidate'}}) }}

								<div class="row">
									<div class="col-md-6 mb-3">
										{{ form_row(form.displayOnHomepage) }}
									</div>
									<div class="col-md-6 mb-3">
										{{ form_row(form.numberOfProducts) }}
									</div>
								</div>

								<div class="row">
									<div class="col-md-6 mb-3">
										{{ form_row(form.period) }}
									</div>
									<div class="col-md-6 mb-3">
										{{ form_row(form.sortBy) }}
									</div>
								</div>

								<div class="mb-3">
									{{ form_row(form.cacheTtl) }}
									<div class="form-hint">
										{{ 'sylius_best_seller.ui.cache_ttl_help'|trans }}
									</div>
								</div>

								<div class="form-footer mt-4">
									<button type="submit" class="btn btn-primary px-4" data-loading>
										<i class="ti ti-device-floppy me-2"></i>
										{{ 'sylius.ui.save'|trans }}
									</button>
									<a href="{{ path('sylius_admin_dashboard') }}" class="btn btn-link link-secondary">
										{{ 'sylius.ui.cancel'|trans }}
									</a>
								</div>

								{{ form_rest(form) }}
								{{ form_end(form) }}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
