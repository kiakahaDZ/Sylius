<?xml version="1.0" encoding="UTF-8"?>
<resources
    xmlns="https://api-platform.com/schema/metadata/resources-3.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://api-platform.com/schema/metadata/resources-3.0 https://api-platform.com/schema/metadata/resources-3.0.xsd"
>
    <resource class="Plugin\SyliusBannerPlugin\Entity\Banner">
        <operations>
            <operation name="sylius_api_shop_banner_get_collection" class="ApiPlatform\Metadata\GetCollection" uriTemplate="/shop/banners">
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>banner:index</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
            </operation>
            <operation name="sylius_api_shop_banner_get" class="ApiPlatform\Metadata\Get" uriTemplate="/shop/banners/{id}">
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>banner:show</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
            </operation>
        </operations>
    </resource>
</resources>
