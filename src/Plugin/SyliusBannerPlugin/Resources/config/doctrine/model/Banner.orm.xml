<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Plugin\SyliusBannerPlugin\Entity\Banner" table="sylius_banner">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="title" type="string" length="255" nullable="true"/>
        <field name="subtitle" type="string" length="500" nullable="true"/>
        <field name="link" type="string" length="500" nullable="true"/>
        <field name="imagePath" column="image_path" type="string" length="500" nullable="true"/>
        <field name="position" type="string" length="50" nullable="false">
            <options>
                <option name="default">hero</option>
            </options>
        </field>
        <field name="enabled" type="boolean" nullable="false">
            <options>
                <option name="default">true</option>
            </options>
        </field>
        <field name="sortOrder" column="sort_order" type="integer" nullable="false">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="createdAt" column="created_at" type="datetime" nullable="false"/>
        <field name="updatedAt" column="updated_at" type="datetime" nullable="true"/>
    </entity>

</doctrine-mapping>
