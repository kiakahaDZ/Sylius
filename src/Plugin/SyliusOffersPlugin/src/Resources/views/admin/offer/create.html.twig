{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}{{ 'sylius.ui.create_offer'|trans }} {{ parent() }}{% endblock %}

{% block body %}
    <div class="page">
        {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}
        {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

        <div class="page-wrapper">
            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <div class="page-pretitle">
                                {{ 'sylius_offers.ui.manage_offers'|trans }}
                            </div>
                            <h2 class="page-title">
                                <i class="ti ti-plus me-2"></i>
                                {{ 'sylius.ui.create_offer'|trans }}
                            </h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="page-body">
                <div class="container-xl">
                    {% include '@SyliusOffersPlugin/admin/offer/_form.html.twig' with {'action': path('sylius_admin_offer_create')} %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
