{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

{{ form_start(form, {'action': action, 'attr': {'class': 'card', 'novalidate': 'novalidate'}}) }}
    <div class="card-header">
        <h3 class="card-title">{{ 'sylius_offers.ui.general'|trans }}</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">{{ form_row(form.code) }}</div>
            <div class="col-md-6">{{ form_row(form.title) }}</div>
        </div>
        
        <div class="mb-3">{{ form_row(form.description) }}</div>
        
        <div class="row">
            <div class="col-md-6">{{ form_row(form.image) }}</div>
            <div class="col-md-6">{{ form_row(form.link) }}</div>
        </div>
        
        <div class="row">
            <div class="col-md-6">{{ form_row(form.badge) }}</div>
            <div class="col-md-6">{{ form_row(form.type) }}</div>
        </div>
        
        <div class="row">
            <div class="col-md-6">{{ form_row(form.position) }}</div>
            <div class="col-md-6">{{ form_row(form.enabled) }}</div>
        </div>
        
        <div class="row">
            <div class="col-md-6">{{ form_row(form.startDate) }}</div>
            <div class="col-md-6">{{ form_row(form.endDate) }}</div>
        </div>
    </div>

    <div class="card-header">
        <h3 class="card-title">{{ 'sylius_offers.ui.targeting'|trans }}</h3>
    </div>
    <div class="card-body">
        <div class="mb-3">
            {{ form_label(form.targetUrls) }}
            <div id="target-urls-list" data-prototype="{{ form_widget(form.targetUrls.vars.prototype)|e }}" class="list-group list-group-flush mb-3">
                {% for targetUrl in form.targetUrls %}
                    <div class="list-group-item d-flex align-items-center">
                        <div class="flex-fill">
                            {{ form_widget(targetUrl) }}
                        </div>
                        <div class="ms-2">
                            <button type="button" class="btn btn-icon btn-danger remove-url">
                                <i class="ti ti-trash"></i>
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary add-url">
                <i class="ti ti-plus"></i>
                {{ 'sylius_offers.ui.add_url'|trans }}
            </button>
            <div class="alert alert-info mt-3 py-2 px-3">
                <i class="ti ti-info-circle me-1"></i>
                <small>{{ 'sylius_offers.ui.target_urls_help'|trans }}</small>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-6">{{ form_row(form.targetProducts) }}</div>
            <div class="col-md-6">{{ form_row(form.targetCategories) }}</div>
        </div>
        
        <div class="row">
            <div class="col-md-6">{{ form_row(form.targetChannels) }}</div>
            <div class="col-md-6">{{ form_row(form.targetLocales) }}</div>
        </div>
    </div>

    <div class="card-header">
        <h3 class="card-title">{{ 'sylius_offers.ui.appearance'|trans }}</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">{{ form_row(form.backgroundColor) }}</div>
            <div class="col-md-4">{{ form_row(form.textColor) }}</div>
            <div class="col-md-4">{{ form_row(form.buttonColor) }}</div>
        </div>
        
        <div class="mb-3">{{ form_row(form.buttonText) }}</div>
    </div>
    
    <div class="card-footer d-flex">
        <div class="btn-list ms-auto">
            <a href="{{ path('sylius_admin_offer_index') }}" class="btn btn-link">
                {{ 'sylius.ui.cancel'|trans }}
            </a>
            <button type="submit" class="btn btn-primary" data-loading>
                {{ 'sylius.ui.save'|trans }}
            </button>
        </div>
    </div>
    
    {{ form_rest(form) }}
{{ form_end(form) }}

<script>
    $(document).ready(function() {
        // Add URL functionality
        $('.add-url').click(function() {
            var list = $('#target-urls-list');
            var prototype = list.data('prototype');
            var index = list.find('.list-group-item').length;
            var newForm = prototype.replace(/__name__/g, index);
            var newItem = $(
                '<div class="list-group-item d-flex align-items-center">' +
                '<div class="flex-fill">' + newForm + '</div>' +
                '<div class="ms-2">' +
                '<button type="button" class="btn btn-icon btn-danger remove-url">' +
                '<i class="ti ti-trash"></i>' +
                '</button>' +
                '</div>' +
                '</div>'
            );
            list.append(newItem);
        });
        
        // Remove URL functionality
        $(document).on('click', '.remove-url', function() {
            $(this).closest('.list-group-item').remove();
        });
    });
</script>