<div class="ui segment" style="background: {{ backgroundColor }}; color: {{ textColor }}; padding: 2rem;">
    <div class="ui grid">
        {% if offer.image %}
            <div class="four wide column">
                <img src="{{ offer.image }}" alt="{{ offer.title }}" style="max-width: 100%;">
            </div>
        {% endif %}
        
        <div class="{% if offer.image %}twelve{% else %}sixteen{% endif %} wide column">
            <h2 class="ui header" style="color: {{ textColor }};">
                {{ offer.title }}
                {% if offer.badge %}
                    <div class="ui {{ offer.badge|lower }} label">{{ offer.badge }}</div>
                {% endif %}
            </h2>
            
            {% if offer.description %}
                <p>{{ offer.description }}</p>
            {% endif %}
            
            {% if offer.endDate %}
                <twig:countdown_timer :offer="offer" />
            {% endif %}
            
            {% if offer.link %}
                <a href="{{ path('sylius_offers_click', {id: offer.id}) }}" 
                   class="ui large button"
                   style="background-color: {{ buttonColor }}; color: {{ textColor }};"
                   target="_blank">
                    {{ buttonText }}
                    <i class="right arrow icon"></i>
                </a>
            {% endif %}
        </div>
    </div>
</div>