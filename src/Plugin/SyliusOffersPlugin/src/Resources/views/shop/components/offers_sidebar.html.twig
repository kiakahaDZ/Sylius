{% set sidebar_offers = sylius_offers_by_type('sidebar', 3) %}

{% if sidebar_offers|length > 0 %}
    <div class="ui segment">
        <h4 class="ui header">
            <i class="gift icon"></i>
            <div class="content">
                {{ 'sylius_offers.ui.special_offers'|trans|default('Special Offers') }}
            </div>
        </h4>
        
        <div class="ui list">
            {% for offer in sidebar_offers %}
                <div class="item">
                    {% if offer.image %}
                        <img class="ui avatar image" src="{{ offer.image }}" alt="{{ offer.title }}">
                    {% endif %}
                    <div class="content">
                        <div class="header">
                            <a href="{{ path('sylius_offers_click', {id: offer.id}) }}" target="_blank">
                                {{ offer.title }}
                            </a>
                        </div>
                        {% if offer.badge %}
                            <div class="description">
                                <span class="ui {{ offer.badge|lower }} tiny label">{{ offer.badge }}</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}