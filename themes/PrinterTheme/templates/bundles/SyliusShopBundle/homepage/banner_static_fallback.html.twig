{# Static hero when no records exist in SyliusBannerPlugin — keep separate from banner.html.twig to avoid render loops. #}
<section class="printer-hero" id="printer-hero" aria-label="{{ 'sylius.ui.home'|trans }}" data-controller="printer-hero">

    <div class="printer-hero__shape printer-hero__shape--1" aria-hidden="true"></div>
    <div class="printer-hero__shape printer-hero__shape--2" aria-hidden="true"></div>

    <div class="printer-hero__slide active" data-printer-hero-target="slide">
        <div class="printer-hero__inner printer-container">
            <div class="printer-hero__content">
                <p class="printer-hero__tagline">
                    {{ 'printer_shop.hero.tagline_1'|trans }}
                </p>
                <h1 class="printer-hero__title">
                    {{ 'printer_shop.hero.title_1'|trans }}
                </h1>
                <p class="printer-hero__subtitle">
                    {{ 'printer_shop.hero.subtitle_1'|trans }}
                </p>
                <div class="printer-hero__actions">
                    <a href="{{ path('sylius_shop_product_index', {'slug': 'all'}) }}" class="printer-hero__cta printer-hero__cta--primary">
                        {{ 'printer_shop.hero.visit_shop'|trans }}
                        <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            </div>
            <div class="printer-hero__visual">
                <img src="{{ asset('build/shop/images/hero-printer-1.png') }}" alt="{{ 'printer_shop.hero.title_1'|trans }}" loading="eager">
            </div>
        </div>
    </div>

    <div class="printer-hero__slide" data-printer-hero-target="slide">
        <div class="printer-hero__inner printer-container">
            <div class="printer-hero__content">
                <p class="printer-hero__tagline">
                    {{ 'printer_shop.hero.tagline_2'|trans }}
                </p>
                <h1 class="printer-hero__title">
                    {{ 'printer_shop.hero.title_2'|trans }}
                </h1>
                <p class="printer-hero__subtitle">
                    {{ 'printer_shop.hero.subtitle_2'|trans }}
                </p>
                <div class="printer-hero__actions">
                    <a href="{{ path('sylius_shop_product_index', {'slug': 'all'}) }}" class="printer-hero__cta printer-hero__cta--primary">
                        {{ 'printer_shop.hero.shop_now'|trans }}
                        <i class="ti ti-chevron-right"></i>
                    </a>
                    <a href="#categories" class="printer-hero__cta printer-hero__cta--secondary">
                        {{ 'printer_shop.hero.explore'|trans }}
                    </a>
                </div>
            </div>
            <div class="printer-hero__visual">
                <img src="{{ asset('build/shop/images/hero-ink-2.png') }}" alt="{{ 'printer_shop.hero.title_2'|trans }}" loading="lazy">
            </div>
        </div>
    </div>

    <div class="printer-hero__slide" data-printer-hero-target="slide">
        <div class="printer-hero__inner printer-container">
            <div class="printer-hero__content">
                <p class="printer-hero__tagline">
                    {{ 'printer_shop.hero.tagline_3'|trans }}
                </p>
                <h1 class="printer-hero__title">
                    {{ 'printer_shop.hero.title_3'|trans }}
                </h1>
                <p class="printer-hero__subtitle">
                    {{ 'printer_shop.hero.subtitle_3'|trans }}
                </p>
                <div class="printer-hero__actions">
                    <a href="{{ path('sylius_shop_product_index', {'slug': 'all'}) }}" class="printer-hero__cta printer-hero__cta--primary">
                        {{ 'printer_shop.hero.see_deals'|trans }}
                        <i class="ti ti-arrow-right"></i>
                    </a>
                </div>
            </div>
            <div class="printer-hero__visual">
                <img src="{{ asset('build/shop/images/hero-toner-3.png') }}" alt="{{ 'printer_shop.hero.title_3'|trans }}" loading="lazy">
            </div>
        </div>
    </div>

    <button
        class="printer-hero__arrow printer-hero__arrow--prev"
        aria-label="{{ 'sylius.ui.previous'|trans }}"
        data-action="click->printer-hero#prev"
    >
        <i class="ti ti-chevron-left"></i>
    </button>
    <button
        class="printer-hero__arrow printer-hero__arrow--next"
        aria-label="{{ 'sylius.ui.next'|trans }}"
        data-action="click->printer-hero#next"
    >
        <i class="ti ti-chevron-right"></i>
    </button>

    <div class="printer-hero__dots" role="tablist" aria-label="{{ 'printer_shop.hero.slides'|trans }}">
        <button class="printer-hero__dot active" role="tab" aria-selected="true" data-action="click->printer-hero#goTo" data-index="0" aria-label="{{ 'printer_shop.hero.slide_n'|trans({'%n%': 1}) }}"></button>
        <button class="printer-hero__dot" role="tab" aria-selected="false" data-action="click->printer-hero#goTo" data-index="1" aria-label="{{ 'printer_shop.hero.slide_n'|trans({'%n%': 2}) }}"></button>
        <button class="printer-hero__dot" role="tab" aria-selected="false" data-action="click->printer-hero#goTo" data-index="2" aria-label="{{ 'printer_shop.hero.slide_n'|trans({'%n%': 3}) }}"></button>
    </div>

</section>
