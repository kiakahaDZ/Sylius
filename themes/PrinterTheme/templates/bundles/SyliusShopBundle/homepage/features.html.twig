{# PrinterTheme - Features / USP Strip #}
{# Shown at the bottom of the homepage #}

<section class="printer-features-strip" aria-label="{{ 'printer_shop.features.title'|trans }}" data-reveal="up">
    <div class="printer-container">
        <div class="printer-features-grid">

            <div class="printer-feature" id="feature-shipping">
                <div class="printer-feature__icon">
                    <i class="ti ti-truck-delivery"></i>
                </div>
                <div class="printer-feature__body">
                    <h4 class="printer-feature__title">{{ 'printer_shop.features.free_shipping'|trans }}</h4>
                    <p class="printer-feature__desc">{{ 'printer_shop.features.free_shipping_desc'|trans }}</p>
                </div>
            </div>

            <div class="printer-feature" id="feature-warranty">
                <div class="printer-feature__icon">
                    <i class="ti ti-shield-check"></i>
                </div>
                <div class="printer-feature__body">
                    <h4 class="printer-feature__title">{{ 'printer_shop.features.warranty'|trans }}</h4>
                    <p class="printer-feature__desc">{{ 'printer_shop.features.warranty_desc'|trans }}</p>
                </div>
            </div>

            <div class="printer-feature" id="feature-support">
                <div class="printer-feature__icon">
                    <i class="ti ti-headset"></i>
                </div>
                <div class="printer-feature__body">
                    <h4 class="printer-feature__title">{{ 'printer_shop.features.support'|trans }}</h4>
                    <p class="printer-feature__desc">{{ 'printer_shop.features.support_desc'|trans }}</p>
                </div>
            </div>

            <div class="printer-feature" id="feature-payment">
                <div class="printer-feature__icon">
                    <i class="ti ti-credit-card"></i>
                </div>
                <div class="printer-feature__body">
                    <h4 class="printer-feature__title">{{ 'printer_shop.features.payment'|trans }}</h4>
                    <p class="printer_feature__desc">{{ 'printer_shop.features.payment_desc'|trans }}</p>
                </div>
            </div>

        </div>
    </div>
</section>
