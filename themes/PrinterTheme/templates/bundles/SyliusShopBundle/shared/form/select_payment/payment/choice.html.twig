{% set form = hookable_metadata.context.form %}

<div class="mb-5">
	{{ form_errors(form.method) }}

	{% for key, choice_form in form.method %}
		{% set method = form.method.vars.choices[key].data %}
		{% set factory_name = method.gatewayConfig.factoryName %}
		<label class="printer-selection-card mb-3" {{ sylius_test_html_attribute('payment-item') }}>
			{{ form_widget(choice_form, sylius_test_form_attribute('payment-method-select')) }}
			<div class="printer-selection-card__content">
				<div class="printer-selection-card__icon">
					{% if method.code == 'chargily_epay' or factory_name == 'chargily_pay' %}
						<i class="ti ti-brand-shopee d-none" aria-hidden="true"></i>
						{# Fallback for Chargily #}
						<img src="https://pay.chargily.com/test/images/logo.svg" alt="Chargily" style="width: 48px; height: 48px; object-fit: contain;">
					{% else %}
						<i class="ti ti-credit-card" aria-hidden="true"></i>
					{% endif %}
				</div>
				<div class="printer-selection-card__info">
					<div class="printer-selection-card__name">{{ method.name }}</div>
					{% if method.instructions %}
						<p class="printer-selection-card__desc mb-0">{{ method.instructions }}</p>
					{% endif %}
				</div>
			</div>
		</label>
	{% else %}
		{% hook 'choice#unavailable' %}
	{% endfor %}
</div>
