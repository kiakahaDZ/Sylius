{% extends '@!SyliusShop/shared/layout/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('printer-theme', null, 'shop') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{# Mount scroll-reveal once so [data-reveal] sections get .revealed (otherwise they stay opacity: 0). #}
{% block body %}
    <div class="printer-reveal-root" data-controller="printer-reveal">
        {{ parent() }}
    </div>
{% endblock %}
