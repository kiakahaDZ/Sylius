<section class="printer-section printer-home-hook-block" role="region" aria-labelledby="{{ hookable_metadata.configuration['test_attribute']|default('latest-products') ~ '-heading' }}">
    <div class="printer-container">
        <div class="printer-section-header">
            <h2 class="printer-section-title" id="{{ hookable_metadata.configuration['test_attribute']|default('latest-products') ~ '-heading' }}">
                {{ hookable_metadata.configuration.title|default('sylius.ui.latest_products')|trans }}
            </h2>
        </div>
        <div {{ sylius_test_html_attribute(hookable_metadata.configuration.test_attribute|default('latest-products')) }}>
            <div class="printer-product-grid">
                {% for product in latest_products %}
                    <div>
                        {{ component('sylius_shop:product:card', { product: product, template: '@SyliusShop/product/common/card.html.twig', hookableMetadata: hookable_metadata }) }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
