{% set form = hookable_metadata.context.form %}

<div class="mb-5" {{ sylius_test_html_attribute('shipments') }}>
    {{ form_errors(form.method) }}

    {% for key, choice_form in form.method %}
        {% set fee = form.method.vars.shipping_costs[choice_form.vars.value] %}
        {% set method = form.method.vars.choices[key].data %}

        <label class="printer-selection-card" {{ sylius_test_html_attribute('shipping-item') }}>
            {{ form_widget(choice_form, sylius_test_form_attribute('shipping-method-select')) }}
            <div class="printer-selection-card__content">
                <div class="printer-selection-card__icon">
                    <i class="ti ti-truck" aria-hidden="true"></i>
                </div>
                <div class="printer-selection-card__info">
                    <div class="printer-selection-card__name">{{ method.name }}</div>
                    {% if method.description %}
                        <p class="printer-selection-card__desc mb-0">{{ method.description }}</p>
                    {% endif %}
                </div>
                <div class="printer-selection-card__price">
                    {% import '@SyliusShop/shared/macro/money.html.twig' as money %}
                    {{ money.convertAndFormat(fee) }}
                </div>
            </div>
        </label>
    {% else %}
        {% hook 'choice#unavailable' %}
    {% endfor %}
</div>
