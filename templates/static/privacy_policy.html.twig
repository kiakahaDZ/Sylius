{% extends '@SyliusShop/layout.html.twig' %}

{% block title %}{{ 'printer_shop.footer.privacy'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="mb-4">{{ 'printer_shop.footer.privacy'|trans }}</h1>
            
            <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5">
                <p class="text-muted">Last Updated: {{ "now"|date("F d, Y") }}</p>
                
                <section class="mb-4">
                    <h3>1. Introduction</h3>
                    <p>Welcome to NovaPrint. We value your privacy and the security of your data. This Privacy Policy explains how we collect, use, and protect your information when you use our website and mobile application.</p>
                </section>

                <section class="mb-4">
                    <h3>2. Data We Collect</h3>
                    <p>We collect the following information to provide and improve our services:</p>
                    <ul>
                        <li><strong>Personal Information:</strong> Name, email address, phone number, and shipping address.</li>
                        <li><strong>Order History:</strong> Details of the printers and supplies you purchase.</li>
                        <li><strong>Device Information:</strong> Basic device details for app performance and internal analytics.</li>
                    </ul>
                </section>

                <section class="mb-4">
                    <h3>3. How We Use Your Data</h3>
                    <p>Your data is used specifically for:</p>
                    <ul>
                        <li>Processing and delivering your orders.</li>
                        <li>Providing technical support for our repair services.</li>
                        <li>Sending important notifications regarding your account or orders.</li>
                    </ul>
                </section>

                <section class="mb-4">
                    <h3>4. Data Safety & Security</h3>
                    <p>We use industry-standard SSL encryption to protect your data in transit. Your payment information is processed through secure, 3rd-party gateways (e.g., Chargily) and is not stored on our primary servers.</p>
                </section>

                <section class="mb-4">
                    <h3>5. Your Rights</h3>
                    <p>You have the right to access, update, or request the deletion of your personal data at any time. To do so, please contact us at contact@novaprintdz.com.</p>
                </section>

                <div class="mt-5 pt-4 border-top">
                    <p class="mb-0">For more information, contact us:</p>
                    <strong>Email:</strong> contact@novaprintdz.com<br>
                    <strong>Phone:</strong> +213 555 123 456
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
